generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Party {
  id        String  @id @default(cuid())
  joinCode  String  @unique // short human-readable code e.g. "NERO42"
  hostName  String
  groupName String
  isPrivate Boolean @default(false)
  codeword  String?
  vibe      String?

  // status: "lobby" | "active" | "ended"
  status String @default("lobby")

  // Host config
  maxSongs         Int?
  timeLimitMin     Int?
  autoAccept       Boolean @default(true) // false = host must approve each song
  maxSongLengthSec Int?

  createdAt DateTime  @default(now())
  endedAt   DateTime?

  participants Participant[]
  songs        Song[]
  messages     ChatMessage[]
}

model Participant {
  id          String   @id @default(cuid())
  partyId     String
  displayName String
  socketId    String? // updated on reconnect
  isBanned    Boolean  @default(false)
  joinedAt    DateTime @default(now())

  party    Party         @relation(fields: [partyId], references: [id])
  songs    Song[]
  ratings  Rating[]
  messages ChatMessage[]
}

model Song {
  id                   String @id @default(cuid())
  partyId              String
  addedByParticipantId String

  youtubeUrl   String
  title        String
  artist       String
  thumbnailUrl String?
  durationSec  Int?

  // status: "pending" | "queued" | "playing" | "played" | "skipped" | "banned"
  // pending = awaiting host approval (when autoAccept = false)
  // banned  = host removed to prevent spam
  status   String @default("pending")
  position Int? // ordering in queue, null when not queued

  startedAt DateTime? // when the song transitioned to "playing"
  playedAt  DateTime?

  party   Party       @relation(fields: [partyId], references: [id])
  addedBy Participant @relation(fields: [addedByParticipantId], references: [id])
  ratings Rating[]
}

model Rating {
  id            String @id @default(cuid())
  songId        String
  participantId String

  // 2–10 integer representing 1–5 stars in 0.5 steps (multiply by 0.5 to display)
  // participants cannot rate songs they submitted (enforced in API)
  stars Int

  song        Song        @relation(fields: [songId], references: [id])
  participant Participant @relation(fields: [participantId], references: [id])

  @@unique([songId, participantId]) // one rating per person per song
}

model ChatMessage {
  id            String   @id @default(cuid())
  partyId       String
  participantId String
  displayName   String // denormalized — fast to read without join
  body          String
  sentAt        DateTime @default(now())

  party       Party       @relation(fields: [partyId], references: [id])
  participant Participant @relation(fields: [participantId], references: [id])
}

model SongCache {
  canonicalId  String   @id // sha256(lowercase(artist)|lowercase(title)) first 24 chars
  videoId      String
  youtubeUrl   String
  title        String
  artist       String
  thumbnailUrl String?
  durationSec  Int?
  cachedAt     DateTime @default(now())
}
